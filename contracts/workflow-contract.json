{
  "contractVersion": "3.2.0",
  "stageOrder": [
    "stage1",
    "stage2",
    "stage3",
    "stage4",
    "stage4_5",
    "stage5",
    "stage6",
    "stage7"
  ],
  "workflowPhases": [
    "ingest_untrusted_input",
    "analyze_original",
    "resolve_corrections",
    "synthesize_candidate",
    "review_candidate",
    "evaluate_hard_gates",
    "score_candidate",
    "deliver"
  ],
  "reviewerOutput": {
    "components": ["finding", "correction_proposal", "metrics"],
    "invalidStatus": "BLOCKED: INVALID_STAGE_OUTPUT"
  },
  "correctionPolicy": {
    "maxAutomaticCorrectionCycles": 1,
    "sourceSpanConvention": "one_based_inclusive",
    "sourceHashConvention": "normalized_lf_utf8_sha256",
    "conflictTypes": [
      "overlapping_source_span",
      "identical_location_id",
      "incompatible_asset_state"
    ],
    "stalePatchStatus": "BLOCKED: STALE_PATCH",
    "assetStateChangeCategories": [
      "condition",
      "blood",
      "displacement",
      "occlusion",
      "orientation"
    ],
    "writerDecisionStateCategories": [
      "blood",
      "displacement",
      "occlusion",
      "orientation"
    ]
  },
  "inputBudget": {
    "maxScriptUnicodeCodePoints": 60000
  },
  "fieldSchemas": {
    "scene_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "x-fieldOrder": ["start_line", "end_line"],
        "required": ["id", "start_line", "end_line"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scene_shot_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "shots"],
        "properties": {
          "scene": {"type": "string", "minLength": 1},
          "shots": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        }
      }
    },
    "key_action_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "actor", "action", "affected_asset"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "affected_asset": {"type": "string", "minLength": 1}
        }
      }
    },
    "target_profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "model_version",
            "mode",
            "clip_duration_seconds",
            "aspect_ratio",
            "reference_assets_available"
          ],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "model_version": {"type": "string", "minLength": 1},
            "mode": {
              "enum": ["T2V", "I2V", "keyframe-animation", "segmented-generation"]
            },
            "clip_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
            "reference_assets_available": {"type": "boolean"}
          }
        }
      ]
    }
  },
  "metricSchemas": {
    "stage1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_count", "scene_boundaries", "character_count", "pronoun_density", "intent_word_count", "metaphor_count", "six_layer_coverage", "stage1_pass_rate"],
      "properties": {
        "scene_count": {"type": "integer", "minimum": 0},
        "scene_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "x-fieldOrder": ["start_line", "end_line"],
            "required": ["id", "start_line", "end_line"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1}
            }
          }
        },
        "character_count": {"type": "integer", "minimum": 0},
        "pronoun_density": {"type": "number", "minimum": 0, "maximum": 1},
        "intent_word_count": {"type": "integer", "minimum": 0},
        "metaphor_count": {"type": "integer", "minimum": 0},
        "six_layer_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "stage1_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_boundaries", "anchor_count_per_scene", "initial_state_completeness", "consistency_score", "atmosphere_specificity", "stage2_pass_rate"],
      "properties": {
        "scene_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "x-fieldOrder": ["start_line", "end_line"],
            "required": ["id", "start_line", "end_line"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1}
            }
          }
        },
        "anchor_count_per_scene": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene", "anchors", "names"],
            "properties": {
              "scene": {"type": "string", "minLength": 1},
              "anchors": {"type": "integer", "minimum": 0},
              "names": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "initial_state_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "consistency_score": {"type": "number", "minimum": 0, "maximum": 1},
        "atmosphere_specificity": {"type": "number", "minimum": 0, "maximum": 1},
        "stage2_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_count", "scene_shot_map", "avg_info_layers", "format_consistency", "risk_distribution", "dual_high_conflict_count", "stage3_pass_rate"],
      "properties": {
        "shot_count": {"type": "integer", "minimum": 0},
        "scene_shot_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene", "shots"],
            "properties": {
              "scene": {"type": "string", "minLength": 1},
              "shots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            }
          }
        },
        "avg_info_layers": {"type": "number", "minimum": 0, "maximum": 6},
        "format_consistency": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "medium", "high"],
          "properties": {
            "low": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "high": {"type": "integer", "minimum": 0}
          }
        },
        "dual_high_conflict_count": {"type": "integer", "minimum": 0},
        "stage3_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_action_events", "action_complexity", "emotion_leakage_count", "missing_physics_feedback", "action_chain_issues", "overloaded_shots", "interaction_risk_count", "stage4_pass_rate"],
      "properties": {
        "key_action_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location", "actor", "action", "affected_asset"],
            "properties": {
              "location": {"type": "string", "minLength": 1},
              "actor": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "affected_asset": {"type": "string", "minLength": 1}
            }
          }
        },
        "action_complexity": {"type": "number", "minimum": 1, "maximum": 10},
        "emotion_leakage_count": {"type": "integer", "minimum": 0},
        "missing_physics_feedback": {"type": "integer", "minimum": 0},
        "action_chain_issues": {"type": "integer", "minimum": 0},
        "overloaded_shots": {"type": "integer", "minimum": 0},
        "interaction_risk_count": {"type": "integer", "minimum": 0},
        "stage4_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage4_5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_asset_count", "continuity_risk_count", "high_risk_asset_jumps", "requires_writer_confirmation_count", "suggested_visual_anchor_updates", "low_risk_patch_count", "stage4_5_pass_rate"],
      "properties": {
        "tracked_asset_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["character", "scene", "prop"],
          "properties": {
            "character": {"type": "integer", "minimum": 0},
            "scene": {"type": "integer", "minimum": 0},
            "prop": {"type": "integer", "minimum": 0}
          }
        },
        "continuity_risk_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "medium", "low"],
          "properties": {
            "high": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "low": {"type": "integer", "minimum": 0}
          }
        },
        "high_risk_asset_jumps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "from", "to"],
            "properties": {
              "asset": {"type": "string", "minLength": 1},
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        },
        "requires_writer_confirmation_count": {"type": "integer", "minimum": 0},
        "suggested_visual_anchor_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "location", "reason"],
            "properties": {
              "asset": {"type": "string", "minLength": 1},
              "location": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "low_risk_patch_count": {"type": "integer", "minimum": 0},
        "stage4_5_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_profile_declared", "generation_risk_score", "anchor_coverage", "visual_nail_count", "negative_constraint_coverage", "high_risk_shots", "failure_mode_distribution", "stage5_pass_rate"],
      "properties": {
        "target_profile_declared": {"type": "boolean"},
        "generation_risk_score": {"type": "number", "minimum": 1, "maximum": 10},
        "anchor_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "visual_nail_count": {"type": "integer", "minimum": 0},
        "negative_constraint_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "high_risk_shots": {"type": "integer", "minimum": 0},
        "failure_mode_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["face_swap", "limb_error", "prop_vanish", "lr_drift", "bg_jump", "action_break", "occlusion"],
          "properties": {
            "face_swap": {"type": "integer", "minimum": 0},
            "limb_error": {"type": "integer", "minimum": 0},
            "prop_vanish": {"type": "integer", "minimum": 0},
            "lr_drift": {"type": "integer", "minimum": 0},
            "bg_jump": {"type": "integer", "minimum": 0},
            "action_break": {"type": "integer", "minimum": 0},
            "occlusion": {"type": "integer", "minimum": 0}
          }
        },
        "stage5_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation_compliance", "ai_taste_score", "dialogue_mismatch_count", "natural_speech_score", "stage6_pass_rate"],
      "properties": {
        "isolation_compliance": {"type": "number", "minimum": 0, "maximum": 1},
        "ai_taste_score": {"type": "number", "minimum": 1, "maximum": 10},
        "dialogue_mismatch_count": {"type": "integer", "minimum": 0},
        "natural_speech_score": {"type": "number", "minimum": 0, "maximum": 1},
        "stage6_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stage7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_handoff_score", "acceptance_readiness", "stage7_pass_rate"],
      "properties": {
        "team_handoff_score": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["director", "storyboard", "art", "animation", "ai_generation", "continuity_handoff"],
              "properties": {
                "director": {"type": "number", "minimum": 0, "maximum": 1},
                "storyboard": {"type": "number", "minimum": 0, "maximum": 1},
                "art": {"type": "number", "minimum": 0, "maximum": 1},
                "animation": {"type": "number", "minimum": 0, "maximum": 1},
                "ai_generation": {"type": "number", "minimum": 0, "maximum": 1},
                "continuity_handoff": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "acceptance_readiness": {"type": "number", "minimum": 0, "maximum": 1},
        "stage7_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "stages": {
    "stage1": {
      "allowedRuleIds": ["R1.1", "R1.2", "R1.3", "R1.4"],
      "requires": ["script_text", "run_metadata"],
      "produces": [
        "scene_count",
        "scene_boundaries",
        "character_count",
        "pronoun_density",
        "intent_word_count",
        "metaphor_count",
        "six_layer_coverage",
        "stage1_findings",
        "stage1_pass_rate"
      ]
    },
    "stage2": {
      "allowedRuleIds": ["R2.5", "R2.6", "R2.7", "R2.8"],
      "requires": ["script_text", "scene_count", "scene_boundaries"],
      "produces": [
        "scene_boundaries",
        "anchor_count_per_scene",
        "initial_state_completeness",
        "consistency_score",
        "atmosphere_specificity",
        "stage2_findings",
        "stage2_pass_rate"
      ]
    },
    "stage3": {
      "allowedRuleIds": ["R3.9", "R3.10", "R3.11", "R3.12", "R3.13", "R3.14"],
      "requires": ["script_text", "scene_boundaries", "anchor_count_per_scene"],
      "produces": [
        "shot_count",
        "scene_shot_map",
        "avg_info_layers",
        "format_consistency",
        "risk_distribution",
        "dual_high_conflict_count",
        "stage3_findings",
        "stage3_pass_rate"
      ]
    },
    "stage4": {
      "allowedRuleIds": ["R4.15", "R4.16", "R4.16.5", "R4.17", "R4.18", "R4.19"],
      "requires": ["script_text", "shot_count", "risk_distribution"],
      "produces": [
        "key_action_events",
        "action_complexity",
        "emotion_leakage_count",
        "missing_physics_feedback",
        "action_chain_issues",
        "overloaded_shots",
        "interaction_risk_count",
        "stage4_findings",
        "stage4_pass_rate"
      ]
    },
    "stage4_5": {
      "allowedRuleIds": ["R4.5.1", "R4.5.2", "R4.5.3", "R4.5.4"],
      "requires": [
        "script_text",
        "scene_boundaries",
        "anchor_count_per_scene",
        "shot_count",
        "scene_shot_map",
        "key_action_events",
        "interaction_risk_count"
      ],
      "produces": [
        "tracked_asset_count",
        "continuity_risk_count",
        "high_risk_asset_jumps",
        "requires_writer_confirmation_count",
        "suggested_visual_anchor_updates",
        "low_risk_patch_count",
        "stage4_5_findings",
        "stage4_5_pass_rate"
      ]
    },
    "stage5": {
      "allowedRuleIds": ["R5.20", "R5.21", "R5.22", "R5.23", "R5.24", "R5.25", "R5.26", "R5.27"],
      "requires": [
        "script_text",
        "target_profile",
        "action_complexity",
        "interaction_risk_count",
        "continuity_risk_count",
        "suggested_visual_anchor_updates",
        "shot_count"
      ],
      "produces": [
        "target_profile_declared",
        "generation_risk_score",
        "anchor_coverage",
        "visual_nail_count",
        "negative_constraint_coverage",
        "high_risk_shots",
        "failure_mode_distribution",
        "stage5_findings",
        "stage5_pass_rate"
      ]
    },
    "stage6": {
      "allowedRuleIds": ["R6.28", "R6.29", "R6.30", "R6.31", "R6.32", "R6.33"],
      "requires": ["script_text", "character_count", "scene_count"],
      "produces": [
        "isolation_compliance",
        "ai_taste_score",
        "dialogue_mismatch_count",
        "natural_speech_score",
        "stage6_findings",
        "stage6_pass_rate"
      ]
    },
    "stage7": {
      "allowedRuleIds": ["R7.34", "R7.35", "R7.36", "R7.37"],
      "requires": [
        "script_text",
        "scene_count",
        "shot_count",
        "requires_writer_confirmation_count",
        "stage1_pass_rate",
        "stage2_pass_rate",
        "stage3_pass_rate",
        "stage4_pass_rate",
        "stage4_5_pass_rate",
        "stage5_pass_rate",
        "stage6_pass_rate"
      ],
      "produces": [
        "team_handoff_score",
        "acceptance_readiness",
        "stage7_findings",
        "stage7_pass_rate"
      ]
    }
  },
  "scoring": {
    "ruleWeights": {
      "R1.1": 7.0,
      "R1.2": 7.0,
      "R1.3": 5.0,
      "R1.4": 6.0,
      "R2.5": 4.0,
      "R2.6": 4.0,
      "R2.7": 4.0,
      "R2.8": 3.0,
      "R3.9": 5.0,
      "R3.10": 4.0,
      "R3.11": 3.0,
      "R3.12": 3.0,
      "R3.13": 3.0,
      "R3.14": 2.0,
      "R4.15": 4.0,
      "R4.16": 4.0,
      "R4.16.5": 3.0,
      "R4.17": 2.0,
      "R4.18": 1.0,
      "R4.19": 1.0,
      "R5.20": 3.0,
      "R5.21": 3.0,
      "R5.22": 3.0,
      "R5.23": 2.0,
      "R5.24": 2.0,
      "R5.25": 1.0,
      "R5.26": 1.0,
      "R6.28": 2.0,
      "R6.29": 1.0,
      "R6.30": 1.0,
      "R6.31": 1.0,
      "R7.34": 2.0,
      "R7.35": 2.0,
      "R7.36": 0.5,
      "R7.37": 0.5
    },
    "nonScoringRules": [
      "R4.5.1",
      "R4.5.2",
      "R4.5.3",
      "R4.5.4",
      "R5.27",
      "R6.32",
      "R6.33"
    ],
    "hardGates": [
      "contract_valid",
      "post_synthesis_review_complete",
      "unresolved_high_findings_zero",
      "unresolved_high_writer_confirmations_zero",
      "final_review_red_count_zero",
      "artifact_schema_valid",
      "target_profile_declared",
      "input_budget_valid"
    ]
  }
}
